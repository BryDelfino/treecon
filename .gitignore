# https://github.com/github/gitignore/blob/main/Dart.gitignore

# Dart/Flutter environment files
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
.lsp-bundle-info

# Build artifacts (Flutter build output)
build/
**/build/

# Android specific
.gradle/
local.properties
**/android/key.properties
**/android/app/local.properties
**/android/.gradle/
**/android/build/
*.apk
*.ap_
*.aab

# iOS/macOS specific
**/ios/.generated/
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/patched_sdk
.DS_Store
**/.DS_Store

# IDEs and Editors
.idea/
.vscode/
*.imap
*.extname
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local/Private configuration
.env
.env.*
! .env.example
